{
  "protocol_version": "acp.v1",
  "documents": [
    {
      "document_type": "pm-analysis",
      "schema_version": "acp.v1",
      "producer": "pm",
      "consumers": ["architect", "pm-finalization", "spec-auditor"],
      "allowed_mutations": ["create a new pm-analysis revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "create or modify architect-owned decisions",
        "create or modify auditor findings"
      ]
    },
    {
      "document_type": "architecture",
      "schema_version": "acp.v1",
      "producer": "architect",
      "consumers": ["pm-finalization", "spec-auditor"],
      "allowed_mutations": ["create a new architecture revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "change PM-owned requirements or business rules",
        "create or modify auditor findings"
      ]
    },
    {
      "document_type": "adr",
      "schema_version": "acp.v1",
      "producer": "architect",
      "consumers": ["pm-finalization", "spec-auditor"],
      "allowed_mutations": ["create a new ADR revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "change PM-owned requirements or business rules",
        "create or modify auditor findings"
      ]
    },
    {
      "document_type": "issue-plan",
      "schema_version": "acp.v1",
      "producer": "pm-finalization",
      "consumers": ["spec-auditor", "issue-publisher"],
      "allowed_mutations": ["create a new issue-plan revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "change PM-owned analysis inputs",
        "change architect-owned architecture or ADR inputs"
      ]
    },
    {
      "document_type": "spec-audit",
      "schema_version": "acp.v1",
      "producer": "spec-auditor",
      "consumers": ["readiness-evaluator", "human-reviewer"],
      "allowed_mutations": ["create a new spec-audit revision containing findings"],
      "forbidden_actions": [
        "mutate an existing revision",
        "change any input artifact",
        "change any PM-owned or architect-owned entity"
      ]
    },
    {
      "document_type": "transition-event",
      "schema_version": "acp.v1",
      "producer": "orchestrator",
      "consumers": ["orchestrator", "human-reviewer"],
      "allowed_mutations": ["append the next immutable transition-event revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "record an undeclared or unguarded transition",
        "reinterpret a transition against another source revision"
      ]
    },
    {
      "document_type": "project-input",
      "schema_version": "acp.v1",
      "producer": "orchestrator",
      "consumers": ["orchestrator", "human-reviewer"],
      "allowed_mutations": ["append a new immutable project-input revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "treat supplied material as an approval or authority attestation",
        "change a PM-owned, architect-owned, or auditor-owned artifact"
      ]
    },
    {
      "document_type": "feature-delta",
      "schema_version": "acp.v1",
      "producer": "orchestrator",
      "consumers": ["orchestrator", "spec-auditor", "human-reviewer"],
      "allowed_mutations": ["append a new immutable feature-delta revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "change any base project artifact or analysis state",
        "claim authority over PM-owned, architect-owned, or auditor-owned entities"
      ]
    },
    {
      "document_type": "github-publication-result",
      "schema_version": "acp.v1",
      "producer": "issue-publisher",
      "consumers": ["issue-publisher", "human-reviewer"],
      "allowed_mutations": ["append a new immutable publication-result revision"],
      "forbidden_actions": [
        "mutate an existing revision",
        "claim an unverified GitHub mapping",
        "change readiness or analysis state"
      ]
    },
    {
      "document_type": "decision-answer",
      "schema_version": "acp.v1",
      "producer": "human-authority",
      "consumers": ["orchestrator", "readiness-evaluator", "human-reviewer"],
      "allowed_mutations": ["append one exact immutable answer record"],
      "forbidden_actions": [
        "mutate an existing revision",
        "change the source decision package or question",
        "select or embed a trusted public key"
      ]
    },
    {
      "document_type": "adr-approval",
      "schema_version": "acp.v1",
      "producer": "human-authority",
      "consumers": ["orchestrator", "readiness-evaluator", "human-reviewer"],
      "allowed_mutations": ["append one exact immutable ADR approval record"],
      "forbidden_actions": [
        "mutate an existing revision",
        "change an Architect-owned ADR",
        "select or embed a trusted public key"
      ]
    },
    {
      "document_type": "design-brief",
      "schema_version": "acp.v1",
      "producer": "pm",
      "consumers": ["design-specialist", "design-auditor", "human-reviewer"],
      "allowed_mutations": ["create a new immutable design-brief revision"],
      "forbidden_actions": ["mutate an existing revision", "create or modify Architect-owned decisions", "create or modify auditor findings"]
    },
    {
      "document_type": "ux-analysis",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-specialist", "design-auditor"],
      "allowed_mutations": ["create a new immutable ux-analysis revision"],
      "forbidden_actions": ["mutate an existing revision", "change PM-owned requirements", "change Architect-owned decisions"]
    },
    {
      "document_type": "user-flow",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-specialist", "design-auditor"],
      "allowed_mutations": ["create a new immutable user-flow revision"],
      "forbidden_actions": ["mutate an existing revision", "change PM-owned requirements", "change Architect-owned decisions"]
    },
    {
      "document_type": "information-architecture",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-specialist", "design-auditor"],
      "allowed_mutations": ["create a new immutable information-architecture revision"],
      "forbidden_actions": ["mutate an existing revision", "change PM-owned requirements", "change Architect-owned decisions"]
    },
    {
      "document_type": "wireframe-plan",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-specialist", "design-auditor"],
      "allowed_mutations": ["create a new immutable wireframe-plan revision"],
      "forbidden_actions": ["mutate an existing revision", "change PM-owned requirements", "change Architect-owned decisions"]
    },
    {
      "document_type": "visual-direction",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-specialist", "design-auditor"],
      "allowed_mutations": ["create a new immutable visual-direction revision"],
      "forbidden_actions": ["mutate an existing revision", "change PM-owned requirements", "change Architect-owned decisions"]
    },
    {
      "document_type": "design-system",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-specialist", "design-auditor", "human-reviewer"],
      "allowed_mutations": ["create a new immutable design-system revision", "add project extensions without changing verified company rules"],
      "forbidden_actions": ["mutate an existing revision", "silently override a verified company binding rule", "change PM-owned requirements or Architect-owned decisions"]
    },
    {
      "document_type": "screen-spec",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-auditor", "issue-publisher"],
      "allowed_mutations": ["create a new immutable screen-spec revision"],
      "forbidden_actions": ["mutate an existing revision", "bypass a binding design-system rule", "change PM-owned requirements or Architect-owned decisions"]
    },
    {
      "document_type": "prototype-manifest",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-auditor", "human-reviewer"],
      "allowed_mutations": ["create a new immutable prototype-manifest revision"],
      "forbidden_actions": ["mutate an existing revision", "treat a production asset as canonical governance authority", "access a referenced network asset"]
    },
    {
      "document_type": "usability-evidence",
      "schema_version": "acp.v1",
      "producer": "design-specialist",
      "consumers": ["design-auditor", "human-reviewer"],
      "allowed_mutations": ["create a new immutable usability-evidence revision"],
      "forbidden_actions": ["mutate an existing revision", "change source flow or prototype artifacts", "change PM-owned requirements or Architect-owned decisions"]
    },
    {
      "document_type": "design-audit",
      "schema_version": "acp.v1",
      "producer": "design-auditor",
      "consumers": ["readiness-evaluator", "human-reviewer"],
      "allowed_mutations": ["create a new immutable design-audit revision containing findings"],
      "forbidden_actions": ["mutate an existing revision", "change any input design artifact", "change PM-owned, Architect-owned, or Spec Auditor-owned artifacts"]
    },
    {
      "document_type": "design-approval",
      "schema_version": "acp.v1",
      "producer": "human-authority",
      "consumers": ["design-auditor", "readiness-evaluator", "human-reviewer"],
      "allowed_mutations": ["append one exact immutable design approval record"],
      "forbidden_actions": ["mutate an existing revision", "change an approved design artifact", "approve a stale artifact revision"]
    }
  ]
}
