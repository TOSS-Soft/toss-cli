{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://toss.software/schemas/design/design-brief.v1.schema.json",
  "title":"TOSS Design Brief v1",
  "description":"Closed PM-owned design intent and source selection for an exact ACP revision.",
  "allOf":[
    {"$ref":"https://toss.software/schemas/common/artifact-envelope.v1.schema.json"},
    {"type":"object","properties":{"schema_version":{"const":"acp.v1"},"document_type":{"const":"design-brief"},"producer":{"type":"object","properties":{"role":{"const":"pm"}}},"content":{"$ref":"#/$defs/content"}}}
  ],
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "id":{"type":"string","pattern":"^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "source":{"enum":["company_system","new_system","AUTO","NOT_APPLICABLE"]},
    "authority":{"type":"object","additionalProperties":false,"required":["role","identity"],"properties":{"role":{"type":"string","minLength":1},"identity":{"type":"string","minLength":1}}},
    "artifact_reference":{"type":"object","additionalProperties":false,"required":["document_type","artifact_id","revision","content_sha256"],"properties":{"document_type":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"artifact_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9:._-]*$"},"revision":{"type":"integer","minimum":1},"content_sha256":{"$ref":"#/$defs/sha256"}}},
    "entity_reference":{"type":"object","additionalProperties":false,"required":["document_type","artifact_id","revision","content_sha256","entity_id"],"properties":{"document_type":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"artifact_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9:._-]*$"},"revision":{"type":"integer","minimum":1},"content_sha256":{"$ref":"#/$defs/sha256"},"entity_id":{"$ref":"#/$defs/id"}}},
    "provenance":{"$ref":"https://toss.software/schemas/common/provenance.v1.schema.json"},
    "binding_value":{"oneOf":[{"type":"object","additionalProperties":false,"required":["token"],"properties":{"token":{"type":"string","minLength":1}}},{"type":"object","additionalProperties":false,"required":["literal"],"properties":{"literal":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]}}}]},
    "asset":{"type":"object","additionalProperties":false,"required":["asset_id","tool","version","integrity","location"],"properties":{"asset_id":{"$ref":"#/$defs/id"},"tool":{"enum":["figma","pencil","code_native"]},"version":{"type":"string","minLength":1,"pattern":".*\\S.*"},"integrity":{"type":"object","additionalProperties":false,"required":["algorithm","value"],"properties":{"algorithm":{"const":"sha256"},"value":{"$ref":"#/$defs/sha256"}}},"location":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","path"],"properties":{"kind":{"const":"path"},"path":{"type":"string","minLength":1}}},{"type":"object","additionalProperties":false,"required":["kind","uri"],"properties":{"kind":{"const":"uri"},"uri":{"type":"string","minLength":1}}}]}}},
    "exception_scope":{"type":"object","additionalProperties":false,"required":["screen_ids","state_ids","component_ids"],"properties":{"screen_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"state_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"component_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "approved_exception":{"type":"object","additionalProperties":false,"required":["exception_id","exact_rule_id","rationale","scope","valid_until","provenance"],"properties":{"exception_id":{"$ref":"#/$defs/id"},"exact_rule_id":{"$ref":"#/$defs/id"},"rationale":{"type":"string","minLength":1,"pattern":".*\\S.*"},"scope":{"$ref":"#/$defs/exception_scope"},"valid_until":{"type":"string","format":"rfc3339-date-time"},"provenance":{"$ref":"#/$defs/provenance"}}},
    "orchestration":{"type":"object","additionalProperties":false,"required":["level","basis"],"properties":{"level":{"enum":["LITE","STANDARD","CRITICAL","NOT_APPLICABLE"]},"basis":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":".*\\S.*"}}}},
    "content":{"type":"object","additionalProperties":false,"required":["design_id","source","purpose","success_criteria","approval_owner"],"properties":{"design_id":{"$ref":"#/$defs/id"},"source":{"$ref":"#/$defs/source"},"purpose":{"type":"string","minLength":1,"pattern":".*\\S.*"},"success_criteria":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":".*\\S.*"}},"approval_owner":{"$ref":"#/$defs/authority"},"orchestration":{"$ref":"#/$defs/orchestration"}}}
  }
}
