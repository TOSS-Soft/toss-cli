{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/core/review-result.v1.schema.json",
  "title": "TOSS Core Review Result v1",
  "description": "A closed independent review result bound to one exact pull request head revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "repository", "pull_request_number", "reviewed_revision", "reviewer", "verdict", "freshness", "findings", "unresolved", "verification_evidence", "follow_up_issues", "reviewed_at", "recorded_at"],
  "properties": {
    "schema_version": {"const": "review-result.v1"},
    "review_id": {"type": "string", "pattern": "^REVIEW-[0-9]{8}-[0-9]{4,}$"},
    "repository": {"$ref": "#/$defs/repository"},
    "pull_request_number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "reviewed_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "verdict": {"enum": ["APPROVED", "BLOCKED", "CHANGES_REQUESTED"]},
    "freshness": {"enum": ["CURRENT", "STALE"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unresolved": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}},
    "verification_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}},
    "follow_up_issues": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/work_item_id"}},
    "reviewed_at": {"type": "string", "format": "rfc3339-date-time"},
    "recorded_at": {"type": "string", "format": "rfc3339-date-time"}
  },
  "$defs": {
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?$"},
    "work_item_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?#[1-9][0-9]*$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role"],
      "properties": {
        "identity": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "role": {"const": "independent-reviewer"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "severity", "summary", "resolved"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^FINDING-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "severity": {"enum": ["Critical", "Important", "Minor"]},
        "summary": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "resolved": {"type": "boolean"}
      }
    }
  }
}
