{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/core/release-program.v1.schema.json",
  "title": "TOSS Core Release Program v1",
  "description": "A closed organization program coordinating zero or one independently versioned release track per repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "phase", "revision", "repository_releases", "dependency_stages", "selected_scope", "deferred_scope", "rationale", "interrupts", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "release-program.v1"},
    "program_id": {"$ref": "#/$defs/program_id"},
    "phase": {"enum": ["ACTIVE", "DRAFT", "PAUSED", "PUBLISHING", "RELEASED", "WAITING_FOR_EPIC"]},
    "revision": {"$ref": "#/$defs/revision"},
    "repository_releases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://toss.software/schemas/core/repository-release.v1.schema.json"}
    },
    "dependency_stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency_stage"}
    },
    "selected_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/selected_scope"}
    },
    "deferred_scope": {
      "type": "array",
      "items": {"$ref": "#/$defs/deferred_scope"}
    },
    "rationale": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repository_rationale"}
    },
    "interrupts": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/interruption"}
      ]
    },
    "created_at": {"type": "string", "format": "rfc3339-date-time"},
    "updated_at": {"type": "string", "format": "rfc3339-date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "WAITING_FOR_EPIC"}}},
      "then": {
        "properties": {
          "repository_releases": {"type": "array", "maxItems": 0},
          "dependency_stages": {"type": "array", "maxItems": 0},
          "selected_scope": {"type": "array", "maxItems": 0},
          "rationale": {"type": "array", "maxItems": 0},
          "interrupts": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "repository_releases": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "program_id": {"type": "string", "pattern": "^TOSS-OS-R[0-9]{4,}$"},
    "release_id": {"type": "string", "pattern": "^REL-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "revision": {"type": "string", "pattern": "^REV-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3,})$"},
    "work_item_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?#[1-9][0-9]*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?$"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "selected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic_id", "outcome", "eligibility"],
      "properties": {
        "epic_id": {"$ref": "#/$defs/work_item_id"},
        "outcome": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "eligibility": {"$ref": "#/$defs/eligibility"}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "unversioned", "decomposed", "registered_repository", "unassigned"],
      "properties": {
        "approved": {"const": true},
        "unversioned": {"const": true},
        "decomposed": {"const": true},
        "registered_repository": {"const": true},
        "unassigned": {"const": true}
      }
    },
    "repository_rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "change_class", "reasons"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "version": {"$ref": "#/$defs/version"},
        "change_class": {"enum": ["major", "minor", "patch"]},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/version_reason"}
        }
      }
    },
    "version_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "scope_ids"],
      "properties": {
        "rule": {"enum": ["breaking_public_boundary", "backward_compatible_feature", "published_product_fix", "unreleased_defect_excluded"]},
        "scope_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/work_item_id"}
        }
      }
    },
    "dependency_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "repository_release_ids"],
      "properties": {
        "stage": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "repository_release_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/release_id"}
        }
      }
    },
    "deferred_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic_id", "reason_code", "explanation", "blocking_ids"],
      "properties": {
        "epic_id": {"$ref": "#/$defs/work_item_id"},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"},
        "explanation": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "blocking_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/work_item_id"}
        }
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "repository_release_id", "paused_release_revision"],
      "properties": {
        "program_id": {"$ref": "#/$defs/program_id"},
        "repository_release_id": {"$ref": "#/$defs/release_id"},
        "paused_release_revision": {"$ref": "#/$defs/revision"}
      }
    }
  }
}
