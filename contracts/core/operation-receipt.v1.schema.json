{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/core/operation-receipt.v1.schema.json",
  "title": "TOSS Core Operation Receipt v1",
  "description": "An immutable result for one completed or failed operation intent attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "receipt_id", "intent_id", "intent_sha256", "created_at", "status", "observed_revisions"],
  "properties": {
    "schema_version": {"const": "operation-receipt.v1"},
    "document_type": {"const": "operation-receipt"},
    "receipt_id": {"type": "string", "pattern": "^RECEIPT-[0-9]{8}-[0-9]{4,}$"},
    "intent_id": {"type": "string", "pattern": "^INTENT-[0-9]{8}-[0-9]{4,}$"},
    "intent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "rfc3339-date-time"},
    "status": {"enum": ["completed", "failed"]},
    "observed_revisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/observed_revision"}
    }
  },
  "$defs": {
    "observed_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "repository", "revision"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^OP-[0-9]{4,}$"},
        "repository": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
