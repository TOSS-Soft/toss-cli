{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/core/epic-plan.v1.schema.json",
  "title": "TOSS Core Epic Plan v1",
  "description": "A closed revision-bound epic decomposition with native children and dependency edges.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "source", "epic", "children", "edges", "content_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "epic-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^EPIC-PLAN-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "source": {"$ref": "#/$defs/source"},
    "epic": {"$ref": "https://toss.software/schemas/core/work-item.v1.schema.json"},
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "https://toss.software/schemas/core/work-item.v1.schema.json"},
          {
            "type": "object",
            "required": ["acceptance_criteria"],
            "properties": {
              "acceptance_criteria": true,
              "kind": {"const": "issue"}
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "https://toss.software/schemas/core/dependency-edge.v1.schema.json"}
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "rfc3339-date-time"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "sha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?$"},
        "revision": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
