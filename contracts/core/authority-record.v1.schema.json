{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/core/authority-record.v1.schema.json",
  "title": "TOSS Core Authority Record v1",
  "description": "A closed, signed authority binding for one governed command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "record_id", "actor", "command", "targets", "expected_revisions", "policy_revision", "issued_at", "expires_at", "signature"],
  "properties": {
    "schema_version": {"const": "authority-record.v1"},
    "document_type": {"const": "authority-record"},
    "record_id": {"type": "string", "pattern": "^AUTH-[0-9]{8}-[0-9]{4,}$"},
    "actor": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "command": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expected_revision"}
    },
    "policy_revision": {"type": "string", "pattern": "^POLICY-[0-9]{4,}$"},
    "issued_at": {"type": "string", "format": "rfc3339-date-time"},
    "expires_at": {"type": "string", "format": "rfc3339-date-time"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "expected_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    }
  }
}
