{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/agents/architecture.v1.schema.json",
  "title": "TOSS Architecture v1",
  "description": "A closed Architect-owned ACP artifact. PM-owned requirements and business rules appear only as exact immutable snapshots.",
  "allOf": [
    {
      "$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": "acp.v1"},
        "document_type": {"const": "architecture"},
        "producer": {
          "type": "object",
          "properties": {
            "role": {"const": "architect"}
          }
        },
        "content": {"$ref": "#/$defs/content"}
      }
    }
  ],
  "$defs": {
    "material_string": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "provenance": {
      "$ref": "https://toss.software/schemas/common/provenance.v1.schema.json"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^(?:REQ|NFR)-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
    },
    "functional_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "meaning", "intent_type", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "kind": {"const": "functional-requirement"},
        "meaning": {"$ref": "#/$defs/material_string"},
        "intent_type": {"const": "business-requirement"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "non_functional_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "meaning", "intent_type", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NFR-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "kind": {"const": "non-functional-requirement"},
        "meaning": {"$ref": "#/$defs/material_string"},
        "intent_type": {
          "enum": ["business-quality-attribute", "business-constraint"]
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "business_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "meaning", "intent_type", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BR-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "kind": {"const": "business-rule"},
        "meaning": {"$ref": "#/$defs/material_string"},
        "intent_type": {"const": "business-rule"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "pm_owned_entity": {
      "oneOf": [
        {"$ref": "#/$defs/functional_requirement"},
        {"$ref": "#/$defs/non_functional_requirement"},
        {"$ref": "#/$defs/business_rule"}
      ]
    },
    "pm_entity_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "canonical_sha256", "snapshot"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:REQ|NFR|BR)-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "functional-requirement",
            "non-functional-requirement",
            "business-rule"
          ]
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot": {"$ref": "#/$defs/pm_owned_entity"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "meaning",
        "responsibility",
        "affected_requirements",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^COMP-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "kind": {"const": "architecture-component"},
        "meaning": {"$ref": "#/$defs/material_string"},
        "responsibility": {"$ref": "#/$defs/material_string"},
        "affected_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "architecture_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "resolution", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ARCHQ-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "status": {"enum": ["resolved", "pending", "blocked"]},
        "resolution": {"$ref": "#/$defs/material_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "unresolved_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "type",
        "severity",
        "owner",
        "status",
        "message",
        "path",
        "affected_entities",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "kind": {"const": "unresolved-finding"},
        "type": {"const": "MISSING_BUSINESS_INFORMATION"},
        "severity": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "owner": {"const": "PM"},
        "status": {"const": "unresolved"},
        "message": {"$ref": "#/$defs/material_string"},
        "path": {"type": "string", "pattern": "^/"},
        "affected_entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:REQ|NFR|BR|FLOW|ARCHQ|ADR|EPIC|ISSUE|AC|RISK|ASM|Q)-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "components",
        "constraints",
        "architecture_questions",
        "pm_entity_snapshots",
        "unresolved_findings"
      ],
      "properties": {
        "summary": {"$ref": "#/$defs/material_string"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component"}
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://toss.software/schemas/agents/architecture-constraint.v1.schema.json"
          }
        },
        "architecture_questions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/architecture_question"}
        },
        "pm_entity_snapshots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pm_entity_snapshot"}
        },
        "unresolved_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/unresolved_finding"}
        }
      }
    }
  }
}
