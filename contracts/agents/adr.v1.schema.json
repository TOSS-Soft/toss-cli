{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/agents/adr.v1.schema.json",
  "title": "TOSS Architecture Decision Record v1",
  "description": "A closed Architect-owned ACP artifact. Each ADR records a complete, traceable technical decision and its approval state.",
  "allOf": [
    {
      "$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": "acp.v1"},
        "document_type": {"const": "adr"},
        "producer": {
          "type": "object",
          "properties": {
            "role": {"const": "architect"}
          }
        },
        "content": {"$ref": "#/$defs/content"}
      }
    }
  ],
  "$defs": {
    "material_string": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "provenance": {
      "$ref": "https://toss.software/schemas/common/provenance.v1.schema.json"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "tradeoffs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "description": {"$ref": "#/$defs/material_string"},
        "tradeoffs": {"$ref": "#/$defs/material_string"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority", "provenance"],
      "properties": {
        "state": {"enum": ["pending", "approved", "rejected"]},
        "authority": {"$ref": "#/$defs/material_string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "meaning",
        "context",
        "options",
        "decision",
        "rationale",
        "consequences",
        "status",
        "approval",
        "resolved_architecture_questions",
        "affected_requirements",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ADR-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
        },
        "kind": {
          "enum": ["architecture-decision", "architecture-decision-record"]
        },
        "meaning": {"$ref": "#/$defs/material_string"},
        "context": {"$ref": "#/$defs/material_string"},
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/option"}
        },
        "decision": {"$ref": "#/$defs/material_string"},
        "rationale": {"$ref": "#/$defs/material_string"},
        "consequences": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/material_string"}
        },
        "status": {
          "enum": ["proposed", "accepted", "blocked", "superseded", "rejected"]
        },
        "approval": {"$ref": "#/$defs/approval"},
        "resolved_architecture_questions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ARCHQ-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
          }
        },
        "affected_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:REQ|NFR)-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
