{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/pipeline/decision-answer.v1.schema.json",
  "title": "TOSS Immutable Decision Answer v1",
  "allOf": [
    {"$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json"},
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": "acp.v1"},
        "document_type": {"const": "decision-answer"},
        "producer": {"type": "object", "properties": {"role": {"const": "human-authority"}}},
        "content": {"$ref": "#/$defs/content"}
      }
    }
  ],
  "$defs": {
    "artifact_reference": {
      "$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json#/$defs/artifact_revision_reference"
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "option_id"],
          "properties": {
            "kind": {"const": "selected-option"},
            "option_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "custom-answer"},
            "value": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id", "source_transition", "source_decision_package_hash",
        "source_decision_package", "source_question", "answer",
        "authority_resolution", "authority_registry", "resolved_decision_package"
      ],
      "properties": {
        "question_id": {"type": "string", "pattern": "^Q-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$"},
        "source_transition": {"$ref": "#/$defs/artifact_reference"},
        "source_decision_package_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_decision_package": {"$ref": "https://toss.software/schemas/pipeline/decision-package.v1.schema.json"},
        "source_question": {"$ref": "https://toss.software/schemas/pipeline/decision-package.v1.schema.json#/$defs/question"},
        "answer": {"$ref": "#/$defs/answer"},
        "authority_resolution": {"$ref": "https://toss.software/schemas/pipeline/decision-package.v1.schema.json#/$defs/blocking_authority_resolution"},
        "authority_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_sha256"],
          "properties": {"content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
        },
        "resolved_decision_package": {"$ref": "https://toss.software/schemas/pipeline/decision-package.v1.schema.json"}
      }
    }
  }
}
