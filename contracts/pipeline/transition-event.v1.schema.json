{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/pipeline/transition-event.v1.schema.json",
  "title": "TOSS Analysis Transition Event v1",
  "description": "An immutable ACP event recording one validated project-analysis state transition and its exact inputs.",
  "allOf": [
    {"$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json"},
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": "acp.v1"},
        "document_type": {"const": "transition-event"},
        "producer": {
          "type": "object",
          "properties": {"role": {"const": "orchestrator"}}
        },
        "content": {"$ref": "#/$defs/content"}
      }
    }
  ],
  "$defs": {
    "state": {
      "enum": [
        "ANALYZING",
        "QUESTIONS_PENDING",
        "USER_DECISION",
        "ARCHITECTURE_PENDING",
        "ADR_PENDING_APPROVAL",
        "PM_FINALIZATION",
        "SPEC_AUDIT",
        "READY_FOR_ISSUES",
        "BLOCKED",
        "FAILED_RETRYABLE",
        "FAILED_TERMINAL"
      ]
    },
    "artifact_reference": {
      "$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json#/$defs/artifact_revision_reference"
    },
    "adr_approval_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_type",
        "owner",
        "adr_references"
      ],
      "properties": {
        "schema_version": {"const": "adr-approval-package.v1"},
        "document_type": {"const": "adr-approval-package"},
        "owner": {"const": "USER"},
        "adr_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/artifact_reference"},
              {"type": "object", "properties": {"document_type": {"const": "adr"}}}
            ]
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner"],
      "properties": {
        "action": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "owner": {"enum": ["PM", "ARCHITECT", "PM_FINALIZATION", "USER"]},
        "decision_package": {
          "oneOf": [
            {"$ref": "https://toss.software/schemas/pipeline/decision-package.v1.schema.json"},
            {"$ref": "#/$defs/adr_approval_package"}
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_state",
        "event",
        "state",
        "source_revision",
        "source_sha256",
        "input_artifacts"
      ],
      "properties": {
        "previous_state": {"$ref": "#/$defs/state"},
        "event": {
          "enum": [
            "QUESTIONS_FOUND",
            "ANALYSIS_COMPLETED",
            "DECISION_STARTED",
            "DECISIONS_RESOLVED",
            "ADR_APPROVAL_REQUIRED",
            "ARCHITECTURE_COMPLETED",
            "ADR_APPROVED",
            "FINALIZATION_COMPLETED",
            "AUDIT_PASSED",
            "AUDIT_BLOCKED",
            "BLOCK",
            "RESUME",
            "FAIL_RETRYABLE",
            "RETRY",
            "FAIL_TERMINAL"
          ]
        },
        "state": {"$ref": "#/$defs/state"},
        "source_revision": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "input_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact_reference"}
        },
        "decision_package": {
          "oneOf": [
            {"$ref": "https://toss.software/schemas/pipeline/decision-package.v1.schema.json"},
            {"$ref": "#/$defs/adr_approval_package"}
          ]
        },
        "next_action": {"$ref": "#/$defs/next_action"},
        "failure": {"$ref": "#/$defs/failure"},
        "resume_state": {"$ref": "#/$defs/state"}
      }
    }
  }
}
