{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/pipeline/feature-delta.v1.schema.json",
  "title": "TOSS Feature Delta v1",
  "description": "An immutable, non-authoritative feature impact delta linked to an exact READY project snapshot.",
  "allOf": [
    {"$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json"},
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": "acp.v1"},
        "document_type": {"const": "feature-delta"},
        "producer": {"type": "object", "properties": {"role": {"const": "orchestrator"}}},
        "content": {"$ref": "#/$defs/content"}
      }
    }
  ],
  "$defs": {
    "reference": {"$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json#/$defs/artifact_revision_reference"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "owner", "message"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "owner": {"enum": ["PM", "ARCHITECT", "PM_FINALIZATION", "USER"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "stage", "project_id", "feature_id", "source_revision",
        "source_sha256", "request", "impact_analysis", "requirement_delta",
        "architecture_impact", "issue_plan_delta", "design_impact", "findings", "audit",
        "readiness", "base_project", "next_command"
      ],
      "properties": {
        "kind": {"const": "feature-delta"},
        "stage": {"enum": ["ADDED", "ANALYZED", "PREPARED"]},
        "project_id": {"type": "string", "minLength": 1},
        "feature_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "request": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "source_locations"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "source_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "impact_analysis": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "affected_entities"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "affected_entities": {
              "type": "array", "uniqueItems": true,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "id"],
                "properties": {
                  "kind": {"type": "string", "minLength": 1},
                  "id": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "requirement_delta": {
          "type": "object", "additionalProperties": false,
          "required": ["added", "changed"],
          "properties": {
            "added": {"type": "array", "items": {"type": "object"}},
            "changed": {"type": "array", "items": {"type": "object"}}
          }
        },
        "architecture_impact": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "affected_adrs", "requires_adr"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "affected_adrs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "requires_adr": {"type": "boolean"}
          }
        },
        "issue_plan_delta": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "issue_ids"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "issue_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "design_impact": {
          "type": "object", "additionalProperties": false,
          "required": [
            "delivery_targets", "affected_surfaces", "risk_signals", "requested_level",
            "source", "purpose", "success_criteria", "approval_owner"
          ],
          "properties": {
            "delivery_targets": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"enum": ["WEB", "MOBILE", "DESKTOP", "API", "CLI", "BACKEND"]}
            },
            "affected_surfaces": {
              "type": "array", "uniqueItems": true,
              "items": {"enum": [
                "SCREEN", "FLOW", "INFORMATION_ARCHITECTURE", "WIREFRAME",
                "VISUAL_DIRECTION", "DESIGN_SYSTEM", "COMPONENT", "INTERACTION",
                "PROTOTYPE", "ACCESSIBILITY"
              ]}
            },
            "risk_signals": {
              "type": "array", "uniqueItems": true,
              "items": {"enum": [
                "MULTI_SCREEN", "NEW_INFORMATION_ARCHITECTURE", "NEW_DESIGN_SYSTEM",
                "PROTOTYPE_REQUIRED", "USER_RESEARCH", "SAFETY_REGULATORY",
                "SECURITY_PRIVACY", "FINANCIAL", "ACCESSIBILITY_HIGH", "IRREVERSIBLE",
                "FAILURE_RECOVERY"
              ]}
            },
            "requested_level": {"enum": ["AUTO", "NOT_APPLICABLE", "LITE", "STANDARD", "CRITICAL"]},
            "source": {"enum": ["company_system", "new_system", "AUTO", "NOT_APPLICABLE"]},
            "purpose": {"type": "string", "minLength": 1},
            "success_criteria": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "approval_owner": {
              "type": "object", "additionalProperties": false,
              "required": ["role", "identity"],
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "identity": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "audit": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "findings"],
          "properties": {
            "status": {"enum": ["PASS", "WARN", "FAIL"]},
            "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
          }
        },
        "readiness": {
          "type": "object", "additionalProperties": false,
          "required": ["ready", "failures", "warnings"],
          "properties": {
            "ready": {"type": "boolean"},
            "failures": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
            "warnings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
          }
        },
        "base_project": {
          "type": "object", "additionalProperties": false,
          "required": ["analysis_id", "state", "source_revision", "source_sha256", "authority", "artifacts"],
          "properties": {
            "analysis_id": {"type": "string", "minLength": 1},
            "state": {"const": "READY_FOR_ISSUES"},
            "source_revision": {"type": "string", "minLength": 1},
            "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "authority": {"const": "reference-only"},
            "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}, "uniqueItems": true}
          }
        },
        "next_command": {"type": "string", "minLength": 1}
      }
    }
  }
}
