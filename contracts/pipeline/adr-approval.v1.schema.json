{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/pipeline/adr-approval.v1.schema.json",
  "title": "TOSS Immutable ADR Approval v1",
  "allOf": [
    {"$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json"},
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": "acp.v1"},
        "document_type": {"const": "adr-approval"},
        "producer": {"type": "object", "properties": {"role": {"const": "human-authority"}}},
        "content": {"$ref": "#/$defs/content"}
      }
    }
  ],
  "$defs": {
    "artifact_reference": {
      "$ref": "https://toss.software/schemas/common/artifact-envelope.v1.schema.json#/$defs/artifact_revision_reference"
    },
    "approval_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "document_type", "owner", "adr_references"],
      "properties": {
        "schema_version": {"const": "adr-approval-package.v1"},
        "document_type": {"const": "adr-approval-package"},
        "owner": {"const": "USER"},
        "adr_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact_reference"}
        }
      }
    },
    "approval_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_kind", "authority", "verification_kind", "actor_id", "actor_role",
        "source_revision", "source_sha256", "adr", "approval_package", "record_id",
        "record_revision", "record_sha256", "timestamp", "signature"
      ],
      "properties": {
        "approval_kind": {"const": "ADR_APPROVAL"},
        "authority": {"const": "A3"},
        "verification_kind": {"const": "A3_VERIFIED_CEO_OR_USER_AUTHORITY"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {"enum": ["CEO", "USER"]},
        "source_revision": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "adr": {"$ref": "#/$defs/artifact_reference"},
        "approval_package": {"$ref": "#/$defs/approval_package"},
        "record_id": {"type": "string", "minLength": 1},
        "record_revision": {"type": "integer", "minimum": 1},
        "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "timestamp": {"type": "string", "format": "rfc3339-date-time"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adr", "source_transition", "approval_package", "approval_record", "authority_registry"],
      "properties": {
        "adr": {"$ref": "#/$defs/artifact_reference"},
        "source_transition": {"$ref": "#/$defs/artifact_reference"},
        "approval_package": {"$ref": "#/$defs/approval_package"},
        "approval_record": {"$ref": "#/$defs/approval_record"},
        "authority_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_sha256"],
          "properties": {"content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
        }
      }
    }
  }
}
