{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://toss.software/schemas/pipeline/design-orchestration-state.v1.schema.json",
  "title":"TOSS Design Orchestration State v1",
  "description":"Immutable level, gate, authority, and exact-artifact state for one design pipeline.",
  "allOf":[
    {"$ref":"https://toss.software/schemas/common/artifact-envelope.v1.schema.json"},
    {
      "type":"object",
      "properties":{
        "schema_version":{"const":"acp.v1"},
        "document_type":{"const":"design-orchestration-state"},
        "producer":{"type":"object","properties":{"role":{"const":"orchestrator"}}},
        "content":{"$ref":"#/$defs/content"}
      }
    }
  ],
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "level":{"enum":["NOT_APPLICABLE","LITE","STANDARD","CRITICAL"]},
    "artifact_ref":{"$ref":"https://toss.software/schemas/common/artifact-envelope.v1.schema.json#/$defs/artifact_revision_reference"},
    "signed_artifact_commitment":{
      "type":"object","additionalProperties":false,
      "required":["artifact_ref","payload_sha256"],
      "properties":{
        "artifact_ref":{"$ref":"#/$defs/artifact_ref"},
        "payload_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["kind","id"],
      "properties":{
        "kind":{"enum":["project","feature"]},
        "id":{"type":"string","minLength":1,"pattern":".*\\S.*"}
      }
    },
    "approval_owner":{
      "type":"object","additionalProperties":false,
      "required":["role","identity"],
      "properties":{
        "role":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "identity":{"type":"string","minLength":1,"pattern":".*\\S.*"}
      }
    },
    "classification_input":{
      "type":"object","additionalProperties":false,
      "required":[
        "schema_version","scope","delivery_targets","affected_surfaces",
        "risk_signals","requested_level","source","purpose","success_criteria",
        "approval_owner"
      ],
      "properties":{
        "schema_version":{"const":"design-classification-input.v1"},
        "scope":{"$ref":"#/$defs/scope"},
        "delivery_targets":{
          "type":"array","minItems":1,"uniqueItems":true,
          "items":{"enum":["WEB","MOBILE","DESKTOP","API","CLI","BACKEND"]}
        },
        "affected_surfaces":{
          "type":"array","uniqueItems":true,
          "items":{"enum":[
            "SCREEN","FLOW","INFORMATION_ARCHITECTURE","WIREFRAME",
            "VISUAL_DIRECTION","DESIGN_SYSTEM","COMPONENT","INTERACTION",
            "PROTOTYPE","ACCESSIBILITY"
          ]}
        },
        "risk_signals":{
          "type":"array","uniqueItems":true,
          "items":{"enum":[
            "MULTI_SCREEN","NEW_INFORMATION_ARCHITECTURE","NEW_DESIGN_SYSTEM",
            "PROTOTYPE_REQUIRED","USER_RESEARCH","SAFETY_REGULATORY",
            "SECURITY_PRIVACY","FINANCIAL","ACCESSIBILITY_HIGH","IRREVERSIBLE",
            "FAILURE_RECOVERY"
          ]}
        },
        "requested_level":{"enum":["AUTO","NOT_APPLICABLE","LITE","STANDARD","CRITICAL"]},
        "source":{"enum":["company_system","new_system","AUTO","NOT_APPLICABLE"]},
        "purpose":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "success_criteria":{
          "type":"array","minItems":1,"uniqueItems":true,
          "items":{"type":"string","minLength":1,"pattern":".*\\S.*"}
        },
        "approval_owner":{"$ref":"#/$defs/approval_owner"}
      }
    },
    "basis":{
      "type":"object","additionalProperties":false,
      "required":[
        "ui_applicable","delivery_targets","affected_surfaces",
        "critical_risk_signals","standard_risk_signals"
      ],
      "properties":{
        "ui_applicable":{"type":"boolean"},
        "delivery_targets":{"$ref":"#/$defs/classification_input/properties/delivery_targets"},
        "affected_surfaces":{"$ref":"#/$defs/classification_input/properties/affected_surfaces"},
        "critical_risk_signals":{"$ref":"#/$defs/classification_input/properties/risk_signals"},
        "standard_risk_signals":{"$ref":"#/$defs/classification_input/properties/risk_signals"}
      }
    },
    "classification":{
      "type":"object","additionalProperties":false,
      "required":[
        "classification_input","recommended_level","effective_level","basis",
        "requires_downgrade_approval"
      ],
      "properties":{
        "classification_input":{"$ref":"#/$defs/classification_input"},
        "recommended_level":{"$ref":"#/$defs/level"},
        "effective_level":{"$ref":"#/$defs/level"},
        "basis":{"$ref":"#/$defs/basis"},
        "requires_downgrade_approval":{"type":"boolean"}
      }
    },
    "signed_approval":{
      "type":"object","additionalProperties":false,
      "required":[
        "approval_kind","decision","design_id","source_revision","source_sha256",
        "recommended_level","effective_level","from_level","to_level","artifact_refs",
        "artifact_commitments",
        "authority","verification_kind","actor_id","actor_role","record_id",
        "record_revision","record_sha256","timestamp","signature"
      ],
      "properties":{
        "approval_kind":{"enum":["CRITICAL_DOWNGRADE","VISUAL_DIRECTION","DESIGN_SYSTEM","FINAL"]},
        "decision":{"const":"APPROVED"},
        "design_id":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "source_revision":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "source_sha256":{"$ref":"#/$defs/sha256"},
        "recommended_level":{"$ref":"#/$defs/level"},
        "effective_level":{"$ref":"#/$defs/level"},
        "from_level":{"oneOf":[{"$ref":"#/$defs/level"},{"type":"null"}]},
        "to_level":{"oneOf":[{"$ref":"#/$defs/level"},{"type":"null"}]},
        "artifact_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/artifact_ref"}},
        "artifact_commitments":{
          "type":"array","uniqueItems":true,
          "items":{"$ref":"#/$defs/signed_artifact_commitment"}
        },
        "authority":{"const":"A3"},
        "verification_kind":{"const":"A3_VERIFIED_CEO_OR_USER_AUTHORITY"},
        "actor_id":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "actor_role":{"enum":["CEO","USER"]},
        "record_id":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "record_revision":{"type":"integer","minimum":1},
        "record_sha256":{"$ref":"#/$defs/sha256"},
        "timestamp":{"type":"string","format":"rfc3339-date-time"},
        "signature":{"type":"string","pattern":"^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "next_action":{
      "type":"object","additionalProperties":false,
      "required":["command","owner","reason"],
      "properties":{
        "command":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "owner":{"enum":["PM","DESIGN_SPECIALIST","DESIGN_AUDITOR","USER"]},
        "reason":{"type":"string","minLength":1,"pattern":".*\\S.*"}
      }
    },
    "payload_commitment":{
      "type":"object","additionalProperties":false,
      "required":[
        "stage","expected_document_type","expected_artifact_ref",
        "payload_sha256","status","artifact_ref"
      ],
      "properties":{
        "stage":{"enum":[
          "BRIEF","ANALYSIS","INFORMATION_ARCHITECTURE","FLOWS","WIREFRAMES",
          "DIRECTION","DESIGN_SYSTEM","SCREENS","PROTOTYPE","USABILITY_EVIDENCE",
          "AUDIT","FINAL_APPROVAL"
        ]},
        "expected_document_type":{"enum":[
          "design-brief","ux-analysis","user-flow","information-architecture",
          "wireframe-plan","visual-direction","design-system","screen-spec",
          "prototype-manifest","usability-evidence","design-audit","design-approval"
        ]},
        "expected_artifact_ref":{"$ref":"#/$defs/artifact_ref"},
        "payload_sha256":{"$ref":"#/$defs/sha256"},
        "status":{"enum":["COLLECTED","APPROVED","PERSISTED"]},
        "artifact_ref":{"oneOf":[{"$ref":"#/$defs/artifact_ref"},{"type":"null"}]}
      }
    },
    "finding":{
      "type":"object","additionalProperties":false,
      "required":["id","severity","owner","message","evidence"],
      "properties":{
        "id":{"type":"string","minLength":1,"pattern":"^[A-Z][A-Z0-9_-]+$"},
        "severity":{"enum":["P0","P1","P2","P3","P4"]},
        "owner":{"enum":["PM","DESIGN_SPECIALIST","DESIGN_AUDITOR","USER"]},
        "message":{"type":"string","minLength":1,"pattern":".*\\S.*"},
        "evidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "content":{
      "type":"object","additionalProperties":false,
      "required":[
        "design_id","scope","classification","required_stages","required_artifact_types",
        "state","gate","artifact_refs","payload_commitments","approvals","next_action",
        "findings"
      ],
      "properties":{
        "design_id":{"type":"string","minLength":1,"pattern":"^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
        "scope":{"$ref":"#/$defs/scope"},
        "classification":{"$ref":"#/$defs/classification"},
        "required_stages":{
          "type":"array","minItems":1,"uniqueItems":true,
          "items":{"enum":[
            "BRIEF","ANALYSIS","INFORMATION_ARCHITECTURE","FLOWS","WIREFRAMES",
            "DIRECTION","DESIGN_SYSTEM","SCREENS","PROTOTYPE","USABILITY_EVIDENCE",
            "AUDIT","FINAL_APPROVAL"
          ]}
        },
        "required_artifact_types":{
          "type":"array","minItems":1,"uniqueItems":true,
          "items":{"enum":[
            "design-brief","ux-analysis","user-flow","information-architecture",
            "wireframe-plan","visual-direction","design-system","screen-spec",
            "prototype-manifest","usability-evidence","design-audit","design-approval"
          ]}
        },
        "state":{"enum":[
          "INITIALIZED","DOWNGRADE_PENDING","ANALYZED","FLOWS_READY","WIREFRAMES_READY",
          "DIRECTION_PENDING","DIRECTION_APPROVED","SYSTEM_PENDING","SYSTEM_APPROVED",
          "SCREENS_READY","PROTOTYPE_READY","USABILITY_EVIDENCE_READY","AUDITED",
          "FINAL_APPROVAL_PENDING","APPROVED","NOT_APPLICABLE"
        ]},
        "gate":{"enum":["NONE","CRITICAL_DOWNGRADE_APPROVAL","DIRECTION_APPROVAL","DESIGN_SYSTEM_APPROVAL","FINAL_APPROVAL","COMPLETE","NOT_APPLICABLE"]},
        "artifact_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/artifact_ref"}},
        "payload_commitments":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/payload_commitment"}},
        "approvals":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/signed_approval"}},
        "next_action":{"$ref":"#/$defs/next_action"},
        "findings":{"type":"array","items":{"$ref":"#/$defs/finding"}}
      }
    }
  }
}
